# Paisa Environment Variables Configuration
# Copy this file to .env and configure local values. Do NOT commit .env.

# App Environment
APP_ENV=local
LOG_LEVEL=debug

# Database Configuration
DATABASE_URL=postgres://postgres:password@localhost:5432/paisa_db?sslmode=disable

# Cache and Session Configuration
REDIS_URL=redis://localhost:6379/0

# Message Queue Configuration
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Authentication Secrets
JWT_SECRET=supersecret_jwt_sign_key_minimum_32_characters_long
JWT_REFRESH_SECRET=supersecret_jwt_refresh_key_minimum_32_characters_long

# Storage (MinIO locally, AWS S3 in cloud)
S3_BUCKET=paisa-receipts
S3_ENDPOINT=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadminpassword

# AI and External Services
AI_SERVICE_URL=http://localhost:8002
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_VISION_KEY=your_google_vision_ocr_key_here

# Notifications
FCM_SERVICE_ACCOUNT=configs/fcm-service-account.json

# Payment Gateways (Razorpay Phase 2/3)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=rzp_test_your_key_secret
