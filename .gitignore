# Paisa Monorepo .gitignore

# Environment Variables
.env
.env.local
.env.*.local

# Operating System Files
.DS_Store
Thumbs.db
db.db
*.db

# IDEs and Editors
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# Go Monolith
/backend/bin/
/backend/cmd/server/server
/backend/cmd/server/server.exe
/backend/main
/backend/main.exe
/backend/vendor/
/backend/covreport.html
/backend/coverage.txt

# Python AI Service
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
ENV/
.pytest_cache/
.coverage
htmlcov/

# Expo / React Native Mobile App
/mobile/node_modules/
/mobile/.expo/
/mobile/dist/
/mobile/npm-debug.log*
/mobile/yarn-error.log*
/mobile/pnpm-debug.log*
/mobile/lerna-debug.log*
/mobile/web-build/
/mobile/ios/build/
/mobile/android/build/
/mobile/android/app/build/
/mobile/*.apk
/mobile/*.aab
/mobile/*.ipa

# Terraform IaC
/infrastructure/terraform/.terraform/
/infrastructure/terraform/*.tfstate
/infrastructure/terraform/*.tfstate.backup
/infrastructure/terraform/.terraform.lock.hcl
/infrastructure/terraform/crash.log
/infrastructure/terraform/terraform.tfvars
/infrastructure/terraform/environments/staging/.terraform/
/infrastructure/terraform/environments/staging/*.tfstate
/infrastructure/terraform/environments/staging/*.tfstate.backup
/infrastructure/terraform/environments/staging/.terraform.lock.hcl
/infrastructure/terraform/environments/staging/terraform.tfvars
/infrastructure/terraform/environments/production/.terraform/
/infrastructure/terraform/environments/production/*.tfstate
/infrastructure/terraform/environments/production/*.tfstate.backup
/infrastructure/terraform/environments/production/.terraform.lock.hcl
/infrastructure/terraform/environments/production/terraform.tfvars

# Local logs
*.log
logs/
